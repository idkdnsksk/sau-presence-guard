    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
